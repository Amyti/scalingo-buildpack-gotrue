#!/usr/bin/env bash

set -eu

BUILD_DIR="$1"
CACHE_DIR="$2"

BIN_DIR="$BUILD_DIR/bin"
mkdir -p "$BIN_DIR"

echo "-----> Installing Supabase Auth (GoTrue)"

if [ -n "${SUPABASE_AUTH_VERSION:-}" ]; then
  TAG="$SUPABASE_AUTH_VERSION"
else
  TAG="$(curl -fsSL https://api.github.com/repos/supabase/auth/releases/latest \
    | sed -n 's/.*"tag_name":[ ]*"\([^"]*\)".*/\1/p' | head -n 1)"
fi

case "$TAG" in
  v*) : ;;
  *) TAG="v$TAG" ;;
esac

echo "-----> Using version: $TAG"

RELEASE_JSON="$(curl -fsSL "https://api.github.com/repos/supabase/auth/releases/tags/$TAG")"
ASSET_URL="$(printf "%s" "$RELEASE_JSON" \
  | sed -n 's/.*"browser_download_url":[ ]*"\([^"]*auth-[^"]*-x86\.tar\.gz\)".*/\1/p' \
  | head -n 1)"

if [ -z "$ASSET_URL" ]; then
  echo "!!!! No x86 tar.gz asset found for $TAG"
  echo "!!!! Check releases assets naming on supabase/auth"
  exit 1
fi

echo "-----> Downloading: $ASSET_URL"

TMP_TGZ="$CACHE_DIR/auth-$TAG-x86.tar.gz"
mkdir -p "$CACHE_DIR"

curl -fSL "$ASSET_URL" -o "$TMP_TGZ"

tar -tzf "$TMP_TGZ" >/dev/null

tar -xzf "$TMP_TGZ" -C "$BIN_DIR"

if [ ! -f "$BIN_DIR/auth" ]; then
  echo "!!!! Extracted archive but no auth binary found in $BIN_DIR"
  echo "!!!! Contents:"
  ls -la "$BIN_DIR"
  exit 1
fi

chmod +x "$BIN_DIR/auth"

echo "-----> Supabase Auth installed to $BIN_DIR/auth"