#!/usr/bin/env bash

set -eu

BUILD_DIR="$1"

echo "-----> Installing Supabase Auth (GoTrue) from fork"

: "${SUPABASE_AUTH_VERSION:=2.185.0}"

AUTH_URL="https://github.com/Amyti/auth-no-to-hardcode/releases/download/v${SUPABASE_AUTH_VERSION}/auth-v${SUPABASE_AUTH_VERSION}-x86.tar.gz"

mkdir -p "$BUILD_DIR/bin"

curl -fSL "$AUTH_URL" | tar -xz -C "$BUILD_DIR/bin"
chmod +x "$BUILD_DIR/bin/auth"

echo "-----> Supabase Auth installed from fork"
