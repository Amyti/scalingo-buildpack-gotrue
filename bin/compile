#!/usr/bin/env bash

set -eu

BUILD_DIR="$1"
CACHE_DIR="$2"

echo "-----> Setup Supabase Auth: Binary + Patched Migrations"

# 1. On définit la version (2.158.0 comme convenu)
: "${SUPABASE_AUTH_VERSION:=2.158.0}"
AUTH_URL="https://github.com/supabase/auth/releases/download/v${SUPABASE_AUTH_VERSION}/auth-v${SUPABASE_AUTH_VERSION}-x86.tar.gz"
SRC_URL="https://github.com/supabase/auth/archive/refs/tags/v${SUPABASE_AUTH_VERSION}.tar.gz"

mkdir -p "$BUILD_DIR/bin"
mkdir -p "$BUILD_DIR/migrations_patched"

# 2. Installation du binaire (Ta méthode)
echo "-----> Downloading Binary: ${AUTH_URL}"
curl -fSL "$AUTH_URL" | tar -xz -C "$BUILD_DIR/bin"
chmod +x "$BUILD_DIR/bin/auth"

# 3. Récupération de TOUTES les migrations SQL d'origine
echo "-----> Fetching all SQL migrations from source..."
TEMP_SRC=$(mktemp -d)
curl -fSL "$SRC_URL" | tar -xz -C "$TEMP_SRC"
# On cherche le dossier migrations dans ce qu'on vient de télécharger
SRC_ROOT=$(find "$TEMP_SRC" -maxdepth 1 -type d -name "auth*")
cp -r "$SRC_ROOT/migrations/"*.sql "$BUILD_DIR/migrations_patched/"
rm -rf "$TEMP_SRC"

# 4. PATCH AUTOMATIQUE DE TOUS LES FICHIERS
# On remplace 'postgres' par 'current_user' partout pour éviter les erreurs de droits
echo "-----> Patching: Replacing 'postgres' with 'current_user' in all files..."
find "$BUILD_DIR/migrations_patched" -name "*.sql" -type f -exec sed -i 's/\bpostgres\b/current_user/g' {} +

# On remplace les templates Go par le schéma 'auth'
echo "-----> Patching: Setting namespace to 'auth'..."
find "$BUILD_DIR/migrations_patched" -name "*.sql" -type f -exec sed -i 's/{{ index .Options "Namespace" }}/auth/g' {} +

echo "-----> Buildpack preparation complete. Ready for manual migration."