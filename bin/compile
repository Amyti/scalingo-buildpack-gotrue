#!/usr/bin/env bash
set -eu

BUILD_DIR="$1"

echo "-----> Setup Supabase Auth"

: "${SUPABASE_AUTH_VERSION:=2.158.0}"
VERSION_TAG="v${SUPABASE_AUTH_VERSION}"

echo "-----> Installing GoTrue Binary (${VERSION_TAG})..."
mkdir -p "$BUILD_DIR/bin"

curl -fSL "https://github.com/supabase/auth/releases/download/${VERSION_TAG}/auth-${VERSION_TAG}-linux-amd64.tar.gz" | tar -xz -C "$BUILD_DIR/bin"

if [ -f "$BUILD_DIR/bin/auth-${VERSION_TAG}-linux-amd64" ]; then
    mv "$BUILD_DIR/bin/auth-${VERSION_TAG}-linux-amd64" "$BUILD_DIR/bin/auth"
fi
chmod +x "$BUILD_DIR/bin/auth"

echo "-----> Patching SQL migrations..."
mkdir -p "$BUILD_DIR/migrations_patched"
TEMP_SRC=$(mktemp -d)
curl -fSL "https://github.com/supabase/auth/archive/refs/tags/${VERSION_TAG}.tar.gz" | tar -xz -C "$TEMP_SRC"
SRC_ROOT=$(find "$TEMP_SRC" -maxdepth 1 -type d -name "auth*")

cp -r "$SRC_ROOT/migrations/"* "$BUILD_DIR/migrations_patched/"
rm -rf "$TEMP_SRC"

find "$BUILD_DIR/migrations_patched" -name "*.sql" -type f -exec sed -i 's/\bpostgres\b/current_user/g' {} +
find "$BUILD_DIR/migrations_patched" -name "*.sql" -type f -exec sed -i 's/\bsupabase_auth_admin\b/current_user/g' {} +
find "$BUILD_DIR/migrations_patched" -name "*.sql" -type f -exec sed -i 's/{{ index .Options "Namespace" }}/auth/g' {} +

echo "-----> Buildpack finished."